# Variáveis de ambiente do backend — KeepUnB
# Copie este arquivo para .env e preencha os valores.

# Banco de Dados
POSTGRES_USER=keepunb
POSTGRES_PASSWORD=changeme
POSTGRES_DB=keepunb_dev
DATABASE_URL=postgresql+asyncpg://keepunb:changeme@db:5432/keepunb_dev

# Banco de Dados de Testes (container isolado)
TEST_DATABASE_URL=postgresql+asyncpg://keepunb:changeme@db_test:5432/keepunb_test

# JWT
SECRET_KEY=changeme-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
APP_ENV=development
DEBUG=true

# KeepUnB — .gitignore

# --- Arquivos de Sistema (OS) ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDEs e Editores ---
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Python (Backend) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv
venv
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node.js / Next.js (Frontend) ---
node_modules/
.next/
out/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.lerna/

# --- Variáveis de Ambiente (CRÍTICO!) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
frontend/.env
!*.env.example

# --- Banco de Dados e Containers ---
*.db
*.sqlite3
pgdata/
docker_postgres_data/

# --- Logs e Arquivos Temporários ---
*.log
logs/
tmp/
site/
